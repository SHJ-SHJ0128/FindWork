# Spring / PostgreSQL
SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5432/job_copilot
SPRING_DATASOURCE_USERNAME=job_copilot
SPRING_DATASOURCE_PASSWORD=replace-me

# DeepSeek (fill only in an untracked .env)
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=replace-me
DEEPSEEK_MODEL=replace-me

# Gmail OAuth (read-only; tokens stay outside Git)
GMAIL_CLIENT_ID=replace-me
GMAIL_CLIENT_SECRET=replace-me
GMAIL_REDIRECT_URI=http://127.0.0.1:8080/api/providers/gmail/callback
GMAIL_REFRESH_TOKEN=replace-me
# Optional short-lived token for a smoke test; refresh token is preferred
GMAIL_ACCESS_TOKEN=
GMAIL_TOKEN_FILE=storage/gmail-refresh-token
GMAIL_LINKEDIN_QUERY=from:(linkedin.com) newer_than:7d
GMAIL_LINKEDIN_SYNC_CRON=0 0 8 * * *
GMAIL_TIME_ZONE=Asia/Shanghai

# Provider switches: risky adapters stay off until explicitly reviewed
PROVIDER_LINKEDIN_ALERTS_ENABLED=true
PROVIDER_BOSS_ENABLED=false
PROVIDER_JOBSPY_ENABLED=false
PROVIDER_BROWSER_ENABLED=false
